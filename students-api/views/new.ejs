<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create a new post</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <h1>Create your new note</h1>
  <form method="post" action="/notes">
    <input class="size" placeholder="enter notes title" name="title"> <br><br>
    <textarea placeholder="enter your content" name="content"></textarea> <br><br>
    <input placeholder="enter the subject" name="subject"> <br><br>
    <input placeholder="which date creating note" name="createdDate"> <br><br>
    <input placeholder="which date creating note" name="updatedDate"><br><br>
    <button>submit</button>
  </form>
</body>
</html>