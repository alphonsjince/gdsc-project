<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Single Note</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <h1>Each Note</h1>
    <div class="note">
      <h3>Title: <%= note.title %></h3>
      <h4>Content: <%= note.content %></h4>
      <h4>Subject: <%= note.subject %></h4>
      <h4 class="date">Created Date: <%= note.createdDate %></h4>
      <h4 class="date">Updated Date: <%= note.updatedDate %></h4>
    </div>
</body>
</html>